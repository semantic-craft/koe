#!/usr/bin/env swift
// Reads and operates the Mac Koe window through the accessibility API, for
// unattended acceptance. Koe must be launched with its accessibility tree on:
//
//   open --env KOE_ACCESSIBILITY_TREE=1 /Applications/Koe.app
//
// Usage:
//   scripts/mac-ax dump [PID]            print the window's element tree
//   scripts/mac-ax press "LABEL" [PID]   press the first element labeled
//                                        exactly LABEL, else the first whose
//                                        label starts with LABEL
//   scripts/mac-ax type "LABEL" "TEXT" [PID]
//                                        set the value of the first text
//                                        field whose label starts with LABEL
//
// A modal panel (such as the file picker) blocks presses in the window
// behind it; close it first. `type` changes what the accessibility API
// reports but not the Flutter text field behind it: saving keeps the old
// text, so type with System Events keystrokes instead. While Koe is in the
// background the tree can lag the screen; activate Koe before dumping. PID defaults to the running /Applications/Koe.app. The calling process
// needs Accessibility permission (System Settings → Privacy & Security).
import AppKit
import ApplicationServices

func fail(_ message: String) -> Never {
  FileHandle.standardError.write((message + "\n").data(using: .utf8)!)
  exit(1)
}

func attribute(_ element: AXUIElement, _ name: String) -> AnyObject? {
  var value: AnyObject?
  AXUIElementCopyAttributeValue(element, name as CFString, &value)
  return value
}

func label(_ element: AXUIElement) -> String {
  for name in [kAXTitleAttribute, kAXDescriptionAttribute, kAXValueAttribute] {
    if let text = attribute(element, name) as? String, !text.isEmpty {
      return text
    }
  }
  return ""
}

func children(_ element: AXUIElement) -> [AXUIElement] {
  attribute(element, kAXChildrenAttribute) as? [AXUIElement] ?? []
}

func find(_ element: AXUIElement, _ match: (AXUIElement) -> Bool) -> AXUIElement? {
  if match(element) { return element }
  for child in children(element) {
    if let hit = find(child, match) { return hit }
  }
  return nil
}

func dump(_ element: AXUIElement, depth: Int = 0) {
  let role = attribute(element, kAXRoleAttribute) as? String ?? "?"
  let text = label(element).replacingOccurrences(of: "\n", with: " ⏎ ")
  print(String(repeating: "  ", count: depth) + role + (text.isEmpty ? "" : " " + text))
  for child in children(element) { dump(child, depth: depth + 1) }
}

var args = Array(CommandLine.arguments.dropFirst())
guard let command = args.first else { fail("usage: mac-ax dump|press|type …") }
args.removeFirst()
let arity = ["dump": 0, "press": 1, "type": 2][command] ?? -1
if arity < 0 { fail("unknown command: \(command)") }
if args.count < arity { fail("missing arguments for \(command)") }
let pid: pid_t
if args.count > arity, let given = pid_t(args[arity]) {
  pid = given
} else if let app = NSWorkspace.shared.runningApplications.first(where: {
  $0.bundleURL?.path == "/Applications/Koe.app"
}) {
  pid = app.processIdentifier
} else {
  fail("Koe is not running")
}
if !AXIsProcessTrusted() { fail("this process has no Accessibility permission") }
let app = AXUIElementCreateApplication(pid)

switch command {
case "dump":
  dump(app)
case "press":
  let wanted = args[0]
  guard let hit = find(app, { label($0) == wanted })
    ?? find(app, { label($0).hasPrefix(wanted) }) else {
    fail("no element labeled \(wanted)")
  }
  let result = AXUIElementPerformAction(hit, kAXPressAction as CFString)
  if result != .success { fail("press failed: \(result.rawValue)") }
default:
  let wanted = args[0]
  guard let hit = find(app, {
    let role = attribute($0, kAXRoleAttribute) as? String
    return (role == kAXTextFieldRole || role == kAXTextAreaRole)
      && label($0).hasPrefix(wanted)
  }) else { fail("no text field labeled \(wanted)") }
  let result = AXUIElementSetAttributeValue(
    hit, kAXValueAttribute as CFString, args[1] as CFString)
  if result != .success { fail("type failed: \(result.rawValue)") }
}
