#!/usr/bin/env bash
# Reference-code retrieval over a local XERJ node (see docs/agents/reference-code.md).
#   scripts/ref sync            fetch pinned repos + locked deps into the cache, then index
#   scripts/ref koe             re-index Koe's own source (main checkout)
#   scripts/ref search "<words>" [-k N]   passages from reference projects (prefix ref)
#   scripts/ref self "<words>"  passages from Koe itself (prefix koe)
#   scripts/ref def "<symbol>"  go-to-definition across reference projects
#   scripts/ref start|stop|status
#   scripts/ref clean           stop the node, delete clones and indices (sync rebuilds them)
set -euo pipefail

XERJ="${XERJ_BIN:-$HOME/.local/bin/xerj}"
URL="http://127.0.0.1:9200"
HOME_DIR="$HOME/.local/share/xerj"        # node data, state journals, pid, log
CACHE="$HOME/.cache/xerj-ref/koe"         # clones and dep copies; safe to delete and re-sync
ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
# The koe index always tracks the main checkout: an autoindex journal is bound to one root.
MAIN="$(git -C "$ROOT" worktree list --porcelain | awk 'NR==1{print $2}')"

# name  url  pinned commit  sparse path ("" = whole repo)
REPOS=(
  "soundcore-upstream https://github.com/tacshi/Soundcore f01a19c227aac0cee9a7c851b3f6b69cf5540a24 -"
  "omi https://github.com/BasedHardware/omi def12bf04e2abdacc03c5c0281ec7a21fffc6b1f app"
)
# Locked packages copied from the pub cache at the version in pubspec.lock.
DEPS=(
  flutter_blue_plus flutter_blue_plus_darwin flutter_blue_plus_platform_interface
  record record_ios record_macos record_platform_interface
  just_audio just_audio_background audio_service audio_session
  opus_codec opus_codec_dart opus_codec_ios opus_codec_macos
  flutter_blue_plus_android record_android
  flutter_secure_storage flutter_secure_storage_darwin audio_decoder flutter_tts
  device_calendar_plus device_calendar_plus_android device_calendar_plus_ios
  quick_actions quick_actions_android quick_actions_ios
)

die() { echo "ref: $*" >&2; exit 1; }
[ -x "$XERJ" ] || die "xerj not installed at $XERJ (curl -fsSL https://xerj.org/get | sh)"

running() { curl -sf -m 2 "$URL/_cluster/health" >/dev/null; }

start() {
  running && return 0
  mkdir -p "$HOME_DIR/data"
  nohup "$XERJ" --insecure --data-dir "$HOME_DIR/data" >"$HOME_DIR/node.log" 2>&1 &
  echo $! >"$HOME_DIR/node.pid"
  for _ in $(seq 1 30); do running && return 0; sleep 1; done
  die "node did not come up; see $HOME_DIR/node.log"
}

stop() {
  [ -f "$HOME_DIR/node.pid" ] || { echo "no node started by scripts/ref"; return 0; }
  kill "$(cat "$HOME_DIR/node.pid")" 2>/dev/null || true
  rm -f "$HOME_DIR/node.pid"
}

locked_version() {
  awk -v p="  $1:" '$0==p{f=1} f&&/^    version:/{gsub(/"/,"",$2); print $2; exit}' "$ROOT/pubspec.lock"
}

index() { # folder prefix
  local rc=0
  "$XERJ" autoindex "$1" --url "$URL" --prefix "$2" --state-dir "$HOME_DIR/state/$2" || rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 3 ] || die "autoindex $1 exited $rc"   # 3 = completed with skipped junk
}

sync() {
  mkdir -p "$CACHE/repos" "$CACHE/deps"
  for entry in "${REPOS[@]}"; do
    read -r name url sha sparse <<<"$entry"
    local dir="$CACHE/repos/$name"
    if [ ! -d "$dir/.git" ]; then
      git init -q "$dir"
      git -C "$dir" remote add origin "$url"
      if [ "$sparse" != "-" ]; then
        git -C "$dir" config remote.origin.partialclonefilter blob:none
        git -C "$dir" sparse-checkout set "$sparse"
      fi
    fi
    if [ "$(git -C "$dir" rev-parse -q --verify HEAD 2>/dev/null)" != "$sha" ]; then
      git -C "$dir" fetch -q --depth 1 --filter=blob:none origin "$sha"
      git -C "$dir" checkout -q --detach "$sha"
    fi
    echo "repo $name @ ${sha:0:12}"
  done
  rm -rf "$CACHE/deps" && mkdir -p "$CACHE/deps"
  for pkg in "${DEPS[@]}"; do
    local v; v="$(locked_version "$pkg")"
    [ -n "$v" ] || { echo "skip $pkg (not in pubspec.lock)"; continue; }
    local src="${PUB_CACHE:-$HOME/.pub-cache}/hosted/pub.dev/$pkg-$v"
    [ -d "$src" ] || die "$src missing; run flutter pub get"
    cp -R "$src" "$CACHE/deps/$pkg-$v"   # autoindex does not follow symlinks
  done
  echo "deps ${#DEPS[@]} packages at locked versions"
  start
  index "$CACHE" ref
}

cmd="${1:-}"; shift || true
case "$cmd" in
  start) start ;;
  stop) stop ;;
  status)
    running || { echo "node down"; exit 1; }
    echo "node up at $URL"
    curl -s "$URL/_cat/indices?h=index,docs.count" | grep -E '^(ref|koe)-' || echo "no ref/koe indices yet" ;;
  sync) sync ;;
  clean)
    stop
    du -sh "$CACHE" "$HOME_DIR" 2>/dev/null || true
    rm -rf "$CACHE" "$HOME_DIR"
    echo "removed; xerj binary kept at $XERJ" ;;
  koe) start; index "$MAIN" koe ;;
  search) start; "$XERJ" search --url "$URL" --prefix ref "$@" ;;
  self) start; "$XERJ" search --url "$URL" --prefix koe "$@" ;;
  def) start; "$XERJ" def --url "$URL" --prefix ref "$@" ;;
  *) sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
