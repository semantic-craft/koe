#!/usr/bin/env python3
"""Run isolated minutes acceptance. Missing evidence is a nonzero result."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import uuid

ROOT = Path(__file__).resolve().parent.parent
MODES = ('offline', 'ios', 'provider', 'device', 'mcp')
CREDENTIAL_NAMES = ('DASHSCOPE_API_KEY', 'ARK_API_KEY', 'DOUBAO_API_KEY',
                    'DOUBAO_TTS_API_KEY', 'OPENAI_API_KEY')


class Blocked(Exception):
    pass


class Failed(Exception):
    pass


def sha(path):
    with Path(path).open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()


def redact(text, environment):
    for key, value in environment.items():
        if value and re.search(r'(KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL)', key):
            text = text.replace(value, '[redacted]')
    text = re.sub(r'https?://[^\s"<>]+', '[url redacted]', text)
    return re.sub(r'(?i)(bearer\s+)[^\s"<>]+', r'\1[redacted]', text)


def valid_alternatives(value):
    if isinstance(value, str):
        return bool(value.strip())
    return (isinstance(value, list) and bool(value) and
            all(isinstance(item, str) and item.strip() for item in value))


def flutter_result(output):
    events = []
    for line in output.splitlines():
        try:
            value = json.loads(line)
            if isinstance(value, dict):
                events.append(value)
        except json.JSONDecodeError:
            pass
    finished = [event for event in events if event.get('type') == 'testDone']
    done = [event for event in events if event.get('type') == 'done']
    if (not finished or not done or done[-1].get('success') is not True or
            any(event.get('skipped') or event.get('result') != 'success'
                for event in finished)):
        raise Failed('Flutter evidence missing, failed or skipped tests')
    return len(finished)


class Verification:
    def __init__(self, mode, output):
        self.mode = mode
        self.environment = dict(os.environ)
        self.directory = output / (datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
                                   + '-' + mode + '-' + uuid.uuid4().hex[:8])
        self.directory.mkdir(parents=True)
        self.receipt = {
            'schema_version': 1, 'mode': mode, 'status': 'running',
            'started_at': datetime.now(timezone.utc).isoformat(),
            'platform': sys.platform, 'steps': [], 'input_sha256': None,
            'models': {}, 'evidence_directory': str(self.directory),
            'commit': subprocess.check_output(
                ['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
            'working_tree_dirty': bool(subprocess.check_output(
                ['git', 'status', '--porcelain'], cwd=ROOT, text=True).strip()),
            'version': next((line.split(':', 1)[1].strip()
                             for line in (ROOT / 'pubspec.yaml').read_text().splitlines()
                             if line.startswith('version:')), 'unknown'),
        }
        self.snapshot = self.source_snapshot()
        source_manifest = self.directory / 'source-manifest.json'
        source_manifest.write_text(json.dumps(self.snapshot, sort_keys=True, indent=2) + '\n')
        self.receipt['source_manifest'] = str(source_manifest)
        self.receipt['source_sha256'] = sha(source_manifest)
        self.save()

    def source_snapshot(self):
        files = set()
        for directory in ('lib', 'test', 'integration_test', 'test_driver'):
            files.update((ROOT / directory).rglob('*.dart'))
        files.update(ROOT / path for path in (
            'pubspec.yaml', 'pubspec.lock', 'scripts/check',
            'scripts/verify-minutes-flow', 'scripts/test_verify_minutes_flow.py'))
        return {str(path.relative_to(ROOT)): sha(path) for path in sorted(files)
                if path.is_file()}

    def save(self):
        (self.directory / 'receipt.json').write_text(
            json.dumps(self.receipt, ensure_ascii=False, indent=2) + '\n')

    def command(self, name, argv, timeout=1200, provider=False):
        environment = dict(self.environment)
        if not provider:
            for key in CREDENTIAL_NAMES:
                environment.pop(key, None)
        environment['KOE_SCREENSHOT_DIR'] = str(self.directory / 'screenshots')
        environment['KOE_MINUTES_PROOF_DIR'] = str(self.directory)
        if provider:
            environment['KOE_VERIFY_PROVIDER'] = '1'
        step = {'name': name, 'status': 'running', 'command': argv,
                'log': str(self.directory / f'{name}.log')}
        self.receipt['steps'].append(step)
        self.save()
        print(f'{name}: running', flush=True)
        try:
            process = subprocess.Popen(argv, cwd=ROOT, env=environment,
                                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                       text=True, start_new_session=True)
            try:
                output, _ = process.communicate(timeout=timeout)
            except (subprocess.TimeoutExpired, KeyboardInterrupt):
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    output, _ = process.communicate(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    output, _ = process.communicate()
                Path(step['log']).write_text(redact(output, self.environment))
                raise Failed(f'{name} interrupted or timed out')
            Path(step['log']).write_text(redact(output, self.environment))
            step['exit_code'] = process.returncode
            if process.returncode != 0:
                raise Failed(f'{name} exited {process.returncode}; see sanitized log')
            step['status'] = 'passed'
            return output
        except (OSError, Failed) as error:
            step['status'] = 'failed'
            step['message'] = redact(str(error), self.environment)
            raise Failed(step['message']) from error
        finally:
            self.save()

    def offline(self):
        paths = ['test/minutes_flow_test.dart', 'test/auto_organize_test.dart',
                 'test/meeting_minutes_test.dart']
        self.receipt['test_source_sha256'] = sha(ROOT / paths[0])
        output = self.command('offline-tests', ['flutter', 'test', '--reporter', 'json', *paths])
        self.receipt['test_events'] = flutter_result(output)
        self.behavior_proof('offline')
        self.receipt['service_evidence'] = 'synthetic ASR and LLM; no provider acceptance'

    def ios(self):
        if sys.platform != 'darwin':
            raise Blocked('iOS verification requires macOS and an available simulator runtime')
        state = json.loads(self.command('simulator-inventory', ['xcrun', 'simctl', 'list', '-j'], 30))
        runtimes = [runtime for runtime in state['runtimes']
                    if runtime.get('isAvailable') and '.iOS-' in runtime['identifier']]
        if not runtimes:
            raise Blocked('No available iOS simulator runtime')
        runtime = sorted(runtimes, key=lambda item: [int(n) for n in item['version'].split('.')])[-1]
        types = [item for item in state['devicetypes'] if item.get('productFamily') == 'iPhone']
        supported = {item['identifier'] for item in runtime.get('supportedDeviceTypes', [])}
        if supported:
            types = [item for item in types if item['identifier'] in supported]
        if not types:
            raise Blocked('No compatible iPhone simulator device type')
        device_type = types[-1]['identifier']
        simulator = self.command('simulator-create', ['xcrun', 'simctl', 'create',
            'Koe Minutes Verify ' + uuid.uuid4().hex[:8], device_type, runtime['identifier']], 30).strip()
        if not re.fullmatch(r'[A-Fa-f0-9-]{36}', simulator):
            raise Failed('simctl did not return a simulator UUID')
        self.receipt['device'] = {'id': simulator, 'type': device_type,
                                  'runtime': runtime['identifier'], 'kind': 'isolated simulator'}
        try:
            self.command('simulator-boot', ['xcrun', 'simctl', 'boot', simulator], 60)
            self.command('simulator-ready', ['xcrun', 'simctl', 'bootstatus', simulator, '-b'], 120)
            target = 'integration_test/minutes_flow_test.dart'
            self.receipt['test_source_sha256'] = sha(ROOT / target)
            output = self.command('ios-flow', ['flutter', 'drive', '-d', simulator,
                '--driver=test_driver/minutes_flow_driver.dart', '--target=' + target], 1500)
            if 'All tests passed.' not in output or re.search(r'\b(?:SKIPPED|skip: true)\b', output):
                raise Failed('iOS test did not report complete success')
            screenshots = sorted((self.directory / 'screenshots').glob('*.png'))
            if not screenshots:
                raise Failed('iOS test produced no screenshots')
            self.behavior_proof('ios')
            self.receipt['screenshots'] = [str(path) for path in screenshots]
            self.receipt['service_evidence'] = 'iOS simulator, synthetic ASR and LLM'
        finally:
            self.command('simulator-delete', ['xcrun', 'simctl', 'delete', simulator], 60)

    def behavior_proof(self, mode):
        proof = self.directory / f'{mode}-proof.json'
        if not proof.is_file():
            raise Failed(f'{mode} structured behavior proof missing')
        payload = json.loads(proof.read_text())
        result = payload.get('minutes_flow') if isinstance(payload, dict) else None
        if not isinstance(result, dict) or not all(result.get(key) is True for key in (
                'durable_readback', 'chapters', 'overflow_checked', 'reopened')):
            raise Failed(f'{mode} persistence, chapters, overflow or reopen proof missing')
        digest = result.get('input_sha256')
        if not isinstance(digest, str) or not re.fullmatch(r'[0-9a-f]{64}', digest):
            raise Failed(f'{mode} synthetic input hash missing')
        self.receipt['input_sha256'] = digest
        self.receipt[f'{mode}_proof'] = str(proof)

    def provider(self):
        audio = self.environment.get('KOE_MINUTES_AUDIO')
        expectation = self.environment.get('KOE_MINUTES_EXPECTATIONS')
        if not audio or not Path(audio).is_file():
            raise Blocked('KOE_MINUTES_AUDIO must name explicitly authorized local test audio')
        if not expectation or not Path(expectation).is_file():
            raise Blocked('KOE_MINUTES_EXPECTATIONS must name its deterministic expectation manifest')
        if not self.environment.get('DASHSCOPE_API_KEY'):
            raise Blocked('DASHSCOPE_API_KEY is unavailable in the existing process environment')
        manifest = json.loads(Path(expectation).read_text())
        digest = sha(audio)
        if not isinstance(manifest, dict):
            raise Blocked('Expectation manifest must be an object')
        if manifest.get('audio_sha256') != digest:
            raise Blocked('Audio hash does not match authorized expectation manifest')
        facts = manifest.get('source_facts', [])
        if not isinstance(facts, list) or not all(isinstance(fact, dict) for fact in facts):
            raise Blocked('source_facts must be a list of objects')
        if not all(isinstance(fact.get('kind'), str) for fact in facts):
            raise Blocked('Each source fact kind must be a string')
        kinds = {fact['kind'] for fact in facts}
        if not {'reason', 'example', 'correction', 'unknown', 'negation'} <= kinds:
            raise Blocked('Manifest needs reason/example/correction/unknown/negation source_facts')
        for fact in facts:
            if not all(valid_alternatives(fact.get(key)) for key in ('source', 'minutes')):
                raise Blocked('Each source fact needs nonempty source/minutes text or alternatives')
        if (not isinstance(manifest.get('forbidden_minutes'), list) or
                not manifest['forbidden_minutes'] or
                not all(isinstance(value, str) and value.strip() for value in manifest['forbidden_minutes'])):
            raise Blocked('Manifest needs forbidden_minutes assertions')
        self.receipt['input_sha256'] = digest
        self.receipt['expectations_sha256'] = sha(expectation)
        self.receipt['models'] = {
            'asr': self.environment.get('KOE_MINUTES_ASR_MODEL', 'qwen-audio-3.1-asr-flash-filetrans'),
            'llm': self.environment.get('KOE_MINUTES_LLM_MODEL', 'qwen3.8-flash'),
        }
        output = self.command('provider-flow', ['flutter', 'test', '--reporter', 'json',
            'test/minutes_provider_flow_test.dart'], 1200, provider=True)
        self.receipt['test_events'] = flutter_result(output)
        proof = self.directory / 'provider-proof.json'
        if not proof.is_file():
            raise Failed('Provider produced no persisted proof')
        result = json.loads(proof.read_text())
        if not all(result.get(key) is True for key in (
                'real_asr', 'real_llm', 'persisted_readback', 'facts_and_sources_checked')):
            raise Failed('Provider proof incomplete')
        self.receipt['provider_proof'] = str(proof)

    def execute(self):
        try:
            for mode in MODES if self.mode == 'all' else (self.mode,):
                if mode in ('device', 'mcp'):
                    raise Blocked(f'{mode} automatic acceptance is not implemented in Slice B')
                getattr(self, mode)()
            if self.source_snapshot() != self.snapshot:
                raise Failed('Source changed during verification; receipt cannot identify one tested version')
            self.receipt['status'] = 'passed'
            return 0
        except (Blocked, Failed, OSError, ValueError, KeyboardInterrupt) as error:
            self.receipt['status'] = 'blocked' if isinstance(error, Blocked) else 'failed'
            self.receipt['steps'].append({'name': 'acceptance', 'status': self.receipt['status'],
                                         'message': redact(str(error), self.environment)})
            return 77 if isinstance(error, Blocked) else 1
        finally:
            self.receipt['finished_at'] = datetime.now(timezone.utc).isoformat()
            self.save()
            print(f"{self.mode}: {self.receipt['status']}")
            print(f"receipt: {self.directory / 'receipt.json'}")


def interrupted(signum, frame):
    raise KeyboardInterrupt(f'signal {signum}')


def main():
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=(*MODES, 'all'))
    parser.add_argument('--output-dir', type=Path, default=ROOT / '.scratch/pstack-relay')
    args = parser.parse_args()
    return Verification(args.mode, args.output_dir.resolve()).execute()


if __name__ == '__main__':
    sys.exit(main())
