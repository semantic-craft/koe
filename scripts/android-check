#!/usr/bin/env bash
# Build, install and run the unattended scenarios in integration_test/android
# on the Pixel connected over adb. Not part of `check`: it needs the device.
#
#   scripts/android-check                 every *_test.dart in integration_test/android
#   scripts/android-check <file>...       only these scenarios
#
# Each scenario file runs on its own, in the order given (a directory in name
# order), except that scenarios which lock the screen run last: the phone's
# PIN keeps it locked after the first of them, and nobody is there to type
# it, so the scenarios after it that need Koe on screen are skipped.
#
# KOE_ANDROID_SERIAL picks the device (default: the Pixel 11 Pro).
# Exit codes: 0 passed, 1 failed, 77 skipped: the device is offline, or a
# scenario could not run on it (the summary at the end says which and why).
set -euo pipefail
# Each asynchronous build/test pipeline owns a process group for cancellation.
set -m
cd "$(dirname "$0")/.."

serial="${KOE_ANDROID_SERIAL:-67241FDKX003EH}"
export KOE_ANDROID_VERIFICATION=1
package=com.semanticcraft.soundcore.verification
activity=com.semanticcraft.soundcore.MainActivity
skipped=77

online() {
  [[ "$(adb -s "$serial" get-state 2>/dev/null || true)" == device ]]
}

state="$(adb -s "$serial" get-state 2>/dev/null || true)"
if [[ "$state" != device ]]; then
  echo "android-check: 跳过（设备离线）: $serial${state:+ ($state)}"
  exit "$skipped"
fi
echo "android-check: $serial $(adb -s "$serial" shell getprop ro.product.model | tr -d '\r') / Android $(adb -s "$serial" shell getprop ro.build.version.release | tr -d '\r')"

lock_dir="${KOE_ANDROID_LOCK_DIR:-$HOME/.cache/koe-pixel.lock}"
if ! mkdir "$lock_dir" 2>/dev/null; then
  echo "android-check: 跳过（设备已有执行者）: $lock_dir"
  exit "$skipped"
fi
skips="$(mktemp)"
dark="$skips.dark"
awake=
cleanup() {
  local job
  for job in $(jobs -pr); do
    kill -TERM -- "-$job" 2>/dev/null || true
    wait "$job" 2>/dev/null || true
  done
  free_screen
  adb -s "$serial" uninstall "$package" </dev/null >/dev/null 2>&1 || true
  rm -f "$skips" "$dark"
  rmdir "$lock_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

wake_screen() {
  rm -f "$dark"
  adb -s "$serial" shell input keyevent KEYCODE_WAKEUP
  adb -s "$serial" shell wm dismiss-keyguard
}

# Left alone, the phone dreams after its screen timeout (30 s). While it
# charges, that is a full-screen Hub screensaver: it covers Koe, takes the
# Home key, and the PIN lock follows. Key presses sent over adb do not count
# as use against it (on 2026-10-22 it dreamt every 30 s through a whole run),
# so the run holds a screen wake lock; turning the screen off for a
# lock-screen scenario still works. The lock stays on the phone until it is
# released and counts acquisitions: a run that lost the phone or was killed
# leaves it held, and the screen then never turns off by itself. So a run
# takes over a lock it finds held instead of taking it again, and at the end
# releases it until it is free. Should the phone dream anyway, it is woken at
# once, except while a scenario holds the screen off.
screen_lock() {
  adb -s "$serial" shell cmd power set-wakelock "$1" SCREEN_BRIGHT_WAKE_LOCK </dev/null >/dev/null 2>&1 ||
    true
}
screen_held() {
  adb -s "$serial" shell cmd power set-wakelock list </dev/null 2>/dev/null |
    grep -q 'SCREEN_BRIGHT_WAKE_LOCK: WakeLock{[^}]*held=true'
}
hold_screen() {
  screen_held || screen_lock acquire
}
free_screen() {
  for _ in 1 2 3 4 5; do
    screen_held || return 0
    screen_lock release
  done
}
keep_awake() {
  while sleep 2; do
    [[ -e "$dark" ]] && continue
    [[ "$(adb -s "$serial" shell dumpsys power </dev/null 2>/dev/null)" == *mWakefulness=Dreaming* ]] ||
      continue
    adb -s "$serial" shell input keyevent KEYCODE_WAKEUP </dev/null >/dev/null 2>&1 || true
  done
}

# Opens Koe through its launcher shortcut <id> with the intent quick_actions
# registered for it, as a long press on the icon does; the launcher only
# offers shortcuts Koe has registered, so an unregistered one is not fired.
launch_shortcut() {
  local id="$1" shortcuts listed
  shortcuts="$(adb -s "$serial" shell cmd shortcut get-shortcuts --flags 2 "$package")"
  listed="$(grep -F "id=$id," <<<"$shortcuts" || true)"
  if [[ -z "$listed" ]]; then
    echo "android-check: $package has no launcher shortcut $id:"
    printf '%s\n' "$shortcuts"
    return
  fi
  echo "android-check: launcher shortcut: $listed"
  adb -s "$serial" shell "am start -a android.intent.action.RUN -c android.intent.category.LAUNCHER -f 0x30000000 -n $package/$activity --es 'some unique action key' $id"
}

# Scenarios ask for what only adb can do by printing a marker line:
#   KOE_ADB: home                   wake-screen, then go to the home screen with Home
#   KOE_ADB: lock-screen            turn the screen off, as the power button does
#   KOE_ADB: wake-screen            turn it on and dismiss a non-secure keyguard
#   KOE_ADB: launch-shortcut <id>   choose shortcut <id> on the Koe icon
#   KOE_ADB: open-koe               wake-screen, then tap the Koe icon: Koe comes back as it was
#   KOE_ADB: skip <reason>          the scenario could not run; exit 77
# adb shell reads its stdin, which here is the scenario output still to come,
# so the answers read /dev/null instead.
answer_scenarios() {
  local line
  while IFS= read -r line; do
    printf '%s\n' "$line"
    case "$line" in
      *"KOE_ADB: home"*)
        wake_screen
        adb -s "$serial" shell input keyevent KEYCODE_HOME
        ;;
      *"KOE_ADB: lock-screen"*)
        touch "$dark"
        adb -s "$serial" shell input keyevent KEYCODE_SLEEP
        ;;
      *"KOE_ADB: wake-screen"*) wake_screen ;;
      *"KOE_ADB: launch-shortcut "*)
        local id="${line##*KOE_ADB: launch-shortcut }"
        launch_shortcut "${id%%[[:space:]]*}"
        ;;
      *"KOE_ADB: open-koe"*)
        wake_screen
        adb -s "$serial" shell am start -a android.intent.action.MAIN \
          -c android.intent.category.LAUNCHER -f 0x10200000 -n "$package/$activity"
        ;;
      *"KOE_ADB: skip "*) printf '%s\n' "${line##*KOE_ADB: skip }" >>"$skips" ;;
    esac </dev/null
  done
}

wake_screen
hold_screen
trust="$(adb -s "$serial" shell dumpsys trust </dev/null)"
if grep -q '(current).*deviceLocked=1' <<<"$trust"; then
  echo "android-check: 手机锁着；需要 Koe 在屏幕上的场景会跳过。解锁后放着别动再跑。"
fi
keep_awake &
awake=$!

# Install with every runtime permission granted, so no system dialog waits
# for a tap. `flutter test` reinstalls over it and keeps the grants, but
# uninstalls Koe when its file ends, so this runs before every scenario.
flutter build apk --debug &
wait "$!"
install_granted() {
  adb -s "$serial" install -r -g build/app/outputs/flutter-apk/app-debug.apk </dev/null
}

targets=("$@")
[[ ${#targets[@]} -gt 0 ]] || targets=(integration_test/android)
scenarios=()
locking=()
for target in "${targets[@]}"; do
  if [[ -d "$target" ]]; then
    files="$(find "$target" -name '*_test.dart' | sort)"
  else
    files="$target"
  fi
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if grep -q -E 'leaveAndLockScreen|KOE_ADB: lock-screen' "$file"; then
      locking+=("$file")
    else
      scenarios+=("$file")
    fi
  done <<<"$files"
done
scenarios+=(${locking[@]+"${locking[@]}"})
echo "android-check: 顺序 ${scenarios[*]##*/}"

failed=0
skips_seen=0
summary=()
for scenario in "${scenarios[@]}"; do
  name="${scenario##*/}"
  if ! online; then
    summary+=("$name: 跳过（设备离线）")
    skips_seen=1
    continue
  fi
  : >"$skips"
  if ! install_granted; then
    if online; then
      summary+=("$name: 失败（安装失败）")
      failed=1
    else
      summary+=("$name: 跳过（设备离线）")
      skips_seen=1
    fi
    continue
  fi
  if [[ "$scenario" == *diarization_test.dart ]]; then
    if [[ -z "${KOE_DIARIZATION_FIXTURES:-}" ]]; then
      summary+=("$name: 跳过（请设置 KOE_DIARIZATION_FIXTURES：模型和中文四人样例目录）")
      skips_seen=1
      continue
    fi
    adb -s "$serial" shell run-as "$package" mkdir -p files/diarization-fixtures
    for fixture in segmentation-model.onnx 3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx 0-four-speakers-zh.wav; do
      adb -s "$serial" shell -T run-as "$package" sh -c "'cat > files/diarization-fixtures/$fixture'" <"$KOE_DIARIZATION_FIXTURES/$fixture"
    done
  fi
  wake_screen
  set +e
  flutter test "$scenario" -d "$serial" --reporter expanded 2>&1 | answer_scenarios &
  wait "$!"
  status=$?
  set -e
  if [[ $status -ne 0 ]] && ! online; then
    summary+=("$name: 跳过（运行中设备离线）")
    skips_seen=1
  elif [[ $status -ne 0 ]]; then
    summary+=("$name: 失败")
    failed=1
  elif [[ -s "$skips" ]]; then
    while IFS= read -r reason; do
      summary+=("$name: 跳过（$reason）")
    done <"$skips"
    skips_seen=1
  else
    summary+=("$name: 通过")
  fi
done
# Leave the phone on screen whatever the scenarios did.
if online; then wake_screen; fi
printf 'android-check: %s\n' "${summary[@]}"
[[ $failed -eq 0 ]] || exit 1
[[ $skips_seen -eq 0 ]] || exit "$skipped"
echo "android-check: passed on $serial ($package)"
