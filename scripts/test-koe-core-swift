#!/usr/bin/env bash
set -euo pipefail
cd "$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cargo run --manifest-path rust/Cargo.toml --bin gen_bindings --quiet -- --check
cargo build --manifest-path rust/Cargo.toml --package koe_core_ffi --release --quiet
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
ARCH=$(uname -m)
swiftc \
  -target "${ARCH}-apple-macos14.0" \
  -import-objc-header rust/koe_core_ffi/include/koe_core_ffi.h \
  -L rust/target/release \
  -lkoe_core_ffi \
  -Xlinker -rpath -Xlinker "$PWD/rust/target/release" \
  darwin/KoeCore.swift \
  darwin/KoeNativeTransport.swift \
  darwin/KoeNativeHost.swift \
  test/native/koe_core_swift_test.swift \
  -o "$work/koe-core-swift-test"
"$work/koe-core-swift-test"

JAVAC_BIN=""
JAVA_BIN=""
if [[ -x "/opt/homebrew/opt/openjdk@21/bin/javac" ]]; then
  JAVAC_BIN="/opt/homebrew/opt/openjdk@21/bin/javac"
  JAVA_BIN="/opt/homebrew/opt/openjdk@21/bin/java"
elif command -v javac >/dev/null 2>&1 && javac -version >/dev/null 2>&1; then
  JAVAC_BIN="$(command -v javac)"
  JAVA_BIN="$(command -v java)"
fi

if [[ -n "$JAVAC_BIN" ]]; then
  "$JAVAC_BIN" -d "$work" test/native/KoeCoreJniTest.java
  "$JAVA_BIN" -cp "$work" com.anker.anker_recorder.KoeCoreJniTest "$PWD/rust/target/release/libkoe_core_ffi.dylib"
fi
