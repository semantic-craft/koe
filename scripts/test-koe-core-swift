#!/usr/bin/env bash
set -euo pipefail
cd "$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cargo run --manifest-path rust/Cargo.toml --bin gen_bindings --quiet -- --check
cargo build --manifest-path rust/Cargo.toml --package koe_core_ffi --release --quiet
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
swiftc \
  -import-objc-header rust/koe_core_ffi/include/koe_core_ffi.h \
  -L rust/target/release \
  -lkoe_core_ffi \
  -Xlinker -rpath -Xlinker "$PWD/rust/target/release" \
  darwin/KoeCore.swift \
  test/native/koe_core_swift_test.swift \
  -o "$work/koe-core-swift-test"
"$work/koe-core-swift-test"
