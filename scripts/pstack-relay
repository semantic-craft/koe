#!/usr/bin/env python3
"""Universal PStack cross-chat relay manager and Antigravity lifecycle hook handler.

Encodes Lauren Tan's (poteto) pstack guide workflow for outcome-only operators, upgraded
with Dynamic Rolling Synthesis (`guard-the-context-window` + `sequence-verifiable-units`):
- North-Star Direction & Architecture Spine (`docs/pstack-relay.md`)
- Rolling slice horizon where only the direction/horizon is sketched up front, and each
  finishing session dynamically synthesizes/refines the next slice's Goal, Done Predicate,
  Learnings, and Watchouts based on live code state (`.scratch/pstack-relay/handoff_capsule.json`)
- Context-window split support (`--partial`) so an agent can stop at an optimal context boundary,
  carve out the remaining work into a fresh continuation slice, and emit the exact next prompt
- Append-only decision trail (`.scratch/pstack-relay/decisions.tsv` for `/show-me-your-work`)
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Any

SLICE_HEADER_RE = re.compile(
    r"^### \[(?P<mark>[ x~])\] Slice (?P<id>[A-Z0-9_]+): (?P<title>.+)$",
    re.MULTILINE,
)

AGENTS_RELAY_BULLET = (
    "- **PStack 动态接力约定（跨对话最优上下文推进）**：全景方向与滚动切片在 [docs/pstack-relay.md](docs/pstack-relay.md)，"
    "决策账本在 `.scratch/pstack-relay/decisions.tsv`。下一棒提示词**禁止死板预写**，必须根据当前会话真实完成的代码、新发现的约束与剩余路线动态合成："
    "每次完成一个可验证单元（或上下文接近最优阈值需切分窗口）时，运行 "
    "`scripts/pstack-relay advance <SLICE_ID> --evidence \"<sha/receipt>\" --learned \"<本轮沉淀的事实与改动>\" "
    "--next-goal \"<基于当前现场动态合成的下一棒目标>\" --next-done \"<下一棒可证伪验收命令>\" --watchouts \"<架构红线与防呆提醒>\" --copy`"
    "（若因上下文上限提前交棒则加 `--partial` 自动裂变续接切片），并在回复末尾附上生成的 `## Next Chat Prompt (Copy & Paste)` 代码块。"
)


def repo_root(explicit_root: str | None = None) -> Path:
    if explicit_root:
        return Path(explicit_root).resolve()
    override = os.environ.get("MI_PSTACK_RELAY_ROOT") or os.environ.get("PSTACK_RELAY_ROOT")
    if override:
        return Path(override).resolve()
    here = Path(__file__).resolve()
    if here.parent.name == "scripts" and (here.parent.parent / "docs" / "pstack-relay.md").exists():
        return here.parent.parent
    if here.parent.name == "scripts" and (here.parent.parent / ".git").exists():
        return here.parent.parent
    return Path.cwd().resolve()


def relay_doc_path(root: Path) -> Path:
    return root / "docs" / "pstack-relay.md"


def scratch_dir(root: Path) -> Path:
    d = root / ".scratch" / "pstack-relay"
    d.mkdir(parents=True, exist_ok=True)
    return d


def decisions_path(root: Path) -> Path:
    path = scratch_dir(root) / "decisions.tsv"
    if not path.exists():
        path.write_text("ts\tphase\tdecision\twhy\tevidence\tresult\n", encoding="utf-8")
    return path


def next_prompt_path(root: Path) -> Path:
    return scratch_dir(root) / "NEXT_PROMPT.md"


def state_json_path(root: Path) -> Path:
    return scratch_dir(root) / "state.json"


def capsule_json_path(root: Path) -> Path:
    return scratch_dir(root) / "handoff_capsule.json"


def load_capsule(root: Path) -> dict[str, Any]:
    path = capsule_json_path(root)
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                return data
        except Exception:
            pass
    return {}


def save_capsule(root: Path, capsule: dict[str, Any]) -> None:
    capsule_json_path(root).write_text(
        json.dumps(capsule, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )


def git_live_summary(root: Path) -> str:
    try:
        head = subprocess.run(
            ["git", "-C", str(root), "log", "-1", "--oneline"],
            capture_output=True,
            text=True,
            check=False,
            timeout=3,
        ).stdout.strip()
        status = subprocess.run(
            ["git", "-C", str(root), "status", "-s"],
            capture_output=True,
            text=True,
            check=False,
            timeout=3,
        ).stdout.strip()
        dirty_count = len([ln for ln in status.splitlines() if ln.strip()]) if status else 0
        if head:
            return f"HEAD `{head}` ({dirty_count} uncommitted paths)"
    except Exception:
        pass
    return "git state unavailable"


def detect_verify_entry(root: Path) -> str:
    skills_dir = root / "skills"
    if skills_dir.is_dir():
        for child in sorted(skills_dir.iterdir()):
            if child.is_dir() and child.name.startswith("verify-") and (child / "SKILL.md").is_file():
                return f"skills/{child.name}/SKILL.md"
    if (root / "scripts" / "verify-offline").exists():
        return "scripts/verify-offline"
    if (root / "scripts" / "check").exists():
        return "scripts/check"
    return "NONE_DETECTED (build verification harness in Slice A via project-verification / create-verification-skill)"


def parse_doc_metadata(markdown: str) -> dict[str, str]:
    meta: dict[str, str] = {"goal": "", "architecture_spine": ""}
    goal_m = re.search(r"^- 总目标：(.+)$", markdown, re.MULTILINE)
    if goal_m:
        meta["goal"] = goal_m.group(1).strip()
    spine_m = re.search(r"^- 架构主线：(.+)$", markdown, re.MULTILINE)
    if spine_m:
        meta["architecture_spine"] = spine_m.group(1).strip()
    return meta


def parse_slices(markdown: str) -> list[dict[str, str]]:
    matches = list(SLICE_HEADER_RE.finditer(markdown))
    slices: list[dict[str, str]] = []
    for idx, m in enumerate(matches):
        start = m.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(markdown)
        body = markdown[start:end]

        def extract_field(label: str) -> str:
            pattern = re.compile(rf"^- \*\*{re.escape(label)}\*\*:\s*(.+)$", re.MULTILINE)
            fm = pattern.search(body)
            return fm.group(1).strip() if fm else ""

        slices.append(
            {
                "id": m.group("id").strip(),
                "mark": m.group("mark"),
                "title": m.group("title").strip(),
                "playbook": extract_field("Playbook"),
                "outcome": extract_field("Outcome"),
                "predicate": extract_field("Done Predicate"),
                "evidence": extract_field("Evidence"),
            }
        )
    return slices


def current_and_last_slice(slices: list[dict[str, str]]) -> tuple[dict[str, str] | None, dict[str, str] | None]:
    last_done: dict[str, str] | None = None
    for s in slices:
        if s["mark"] == "x":
            last_done = s
    for s in slices:
        if s["mark"] in ("~", " "):
            return s, last_done
    return None, last_done


def append_decision(root: Path, phase: str, decision: str, why: str, evidence: str, result: str) -> None:
    def clean(cell: str) -> str:
        c = re.sub(r"[\t\r\n]+", " ", cell).strip()
        if c and c[0] in ("=", "+", "-", "@"):
            c = "'" + c
        return c

    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    row = "\t".join([ts, clean(phase), clean(decision), clean(why), clean(evidence), clean(result)]) + "\n"
    with decisions_path(root).open("a", encoding="utf-8") as f:
        f.write(row)


def render_prompt(root: Path, markdown: str, slices: list[dict[str, str]]) -> str:
    nxt, last_done = current_and_last_slice(slices)
    verify_entry = detect_verify_entry(root)
    meta = parse_doc_metadata(markdown)
    capsule = load_capsule(root)
    git_summary = git_live_summary(root)

    if nxt is None:
        return (
            "/poteto-mode\n"
            "new task. All slices in `docs/pstack-relay.md` are marked `[x]`.\n"
            "- Goal: Run the morning audit over `.scratch/pstack-relay/decisions.tsv` (`show-me-your-work`) and present a plain-language catch-up (`ketchup`) of everything shipped and any remaining physical/human-only checks.\n"
            "- Done check: `scripts/pstack-relay status --require-all-done` exits 0.\n"
        )

    last_summary = (
        f"Slice {last_done['id']} ({last_done['title']}), evidence {last_done['evidence']}"
        if last_done
        else "None (starting first slice)"
    )

    lines = [
        "/poteto-mode",
        "new task. Take over this repo from `docs/pstack-relay.md` and `.scratch/pstack-relay/decisions.tsv` (treat the prior trail as authoritative; do not redo finished slices).",
    ]
    if meta.get("goal"):
        lines.append(f"- North Star: {meta['goal']}")
    if meta.get("architecture_spine"):
        lines.append(f"- Unified Architecture Spine (no copy-paste glue): {meta['architecture_spine']}")
    lines.append(f"- Last completed: {last_summary} | Live repo: {git_summary}")
    if capsule.get("learned"):
        lines.append(f"- What the previous session established (`--learned`): {capsule['learned']}")
    if capsule.get("watchouts"):
        lines.append(f"- Architectural invariants & watchouts (`--watchouts`): {capsule['watchouts']}")
    lines.extend(
        [
            f"- Goal (**Slice {nxt['id']}: {nxt['title']}**): {nxt['outcome']}",
            f"- Done means (falsifiable check): {nxt['predicate']}",
            f"- Proof to show: real command output and artifact receipt from `{verify_entry}` (`prove-it-works`, not 'it compiles').",
            "- Real constraints:",
            "  1. In your first message, restate my goal and the smallest architectural change in plain words, then proceed immediately without waiting for confirmation (`never-block-on-the-human`).",
            "  2. I am the product owner and do not make code or architecture choices; settle all technical forks yourself with running code or prototypes instead of asking me.",
            "  3. Keep a decision trail in `.scratch/pstack-relay/decisions.tsv` (`show-me-your-work`).",
            "  4. Guard the context window (`guard-the-context-window`): next-session prompts are NEVER static pre-written text. When this slice passes verification (or if context grows heavy mid-slice and you complete a clean verifiable sub-unit via `--partial`), dynamically synthesize the next session's prompt from live reality by running:",
            f"     `scripts/pstack-relay advance {nxt['id']} --evidence \"<commit-or-receipt>\" --learned \"<what you proved/changed>\" --next-goal \"<refined next outcome if needed>\" --next-done \"<refined next check if needed>\" --watchouts \"<invariants for next chat>\" --copy`",
            "     and end your reply with the `## Next Chat Prompt (Copy & Paste)` code block.",
        ]
    )
    return "\n".join(lines) + "\n"


def copy_to_clipboard(text: str) -> bool:
    if os.environ.get("MI_DISABLE_PBCOPY") == "1" or os.environ.get("PSTACK_DISABLE_PBCOPY") == "1":
        return False
    try:
        proc = subprocess.run(["pbcopy"], input=text.encode("utf-8"), check=False, timeout=3)
        return proc.returncode == 0
    except Exception:
        return False


def sync_files(root: Path, copy: bool = False) -> tuple[str, dict[str, Any]]:
    doc = relay_doc_path(root)
    if not doc.exists():
        raise SystemExit(f"missing relay doc: {doc} (run `pstack-relay init --goal '...'` first)")
    markdown = doc.read_text(encoding="utf-8")
    slices = parse_slices(markdown)
    prompt = render_prompt(root, markdown, slices)
    next_prompt_path(root).write_text(prompt, encoding="utf-8")
    decisions_path(root)
    nxt, last_done = current_and_last_slice(slices)
    copied = copy_to_clipboard(prompt) if copy else False
    state = {
        "updated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "verify_entry": detect_verify_entry(root),
        "next_slice": nxt["id"] if nxt else None,
        "next_title": nxt["title"] if nxt else None,
        "last_completed_slice": last_done["id"] if last_done else None,
        "completed_count": sum(1 for s in slices if s["mark"] == "x"),
        "total_count": len(slices),
        "next_prompt_path": str(next_prompt_path(root)),
        "decisions_path": str(decisions_path(root)),
        "capsule_path": str(capsule_json_path(root)),
        "copied_to_clipboard": copied,
    }
    state_json_path(root).write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return prompt, state


def ensure_exclude_line(root: Path, pattern: str) -> None:
    git_dir = root / ".git"
    if git_dir.is_file():
        raw = git_dir.read_text(encoding="utf-8").strip()
        if raw.startswith("gitdir:"):
            git_dir = (root / raw.split(":", 1)[1].strip()).resolve()
    info_dir = git_dir / "info"
    if not info_dir.is_dir():
        return
    exclude = info_dir / "exclude"
    existing = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    lines = [line.strip() for line in existing.splitlines()]
    if pattern not in lines:
        prefix = "" if (not existing or existing.endswith("\n")) else "\n"
        exclude.write_text(existing + f"{prefix}{pattern}\n", encoding="utf-8")


def cmd_init(root: Path, goal: str, reference: str | None, spine: str | None, copy: bool) -> int:
    (root / "docs").mkdir(parents=True, exist_ok=True)
    (root / "scripts").mkdir(parents=True, exist_ok=True)
    target_script = root / "scripts" / "pstack-relay"
    this_script = Path(__file__).resolve()
    if this_script != target_script.resolve():
        target_script.write_text(this_script.read_text(encoding="utf-8"), encoding="utf-8")
        target_script.chmod(0o755)

    agents_dir = root / ".agents"
    agents_dir.mkdir(parents=True, exist_ok=True)
    hooks_path = agents_dir / "hooks.json"
    hooks_data: dict[str, Any] = {}
    if hooks_path.exists():
        try:
            hooks_data = json.loads(hooks_path.read_text(encoding="utf-8"))
        except Exception:
            hooks_data = {}
    hooks_data["pstack-relay"] = {
        "SessionStart": [
            {
                "type": "command",
                "command": f"python3 '{target_script}' hook SessionStart",
                "timeout": 10,
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": f"python3 '{target_script}' hook Stop",
                "timeout": 10,
            }
        ],
    }
    hooks_path.write_text(json.dumps(hooks_data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    ensure_exclude_line(root, ".agents/")
    ensure_exclude_line(root, ".scratch/")

    agents_md = root / "AGENTS.md"
    if agents_md.exists():
        content = agents_md.read_text(encoding="utf-8")
        if "docs/pstack-relay.md" not in content:
            lines = content.splitlines()
            if lines and lines[0].startswith("# "):
                lines.insert(1, "")
                lines.insert(2, AGENTS_RELAY_BULLET)
                agents_md.write_text("\n".join(lines) + "\n", encoding="utf-8")
            else:
                agents_md.write_text(AGENTS_RELAY_BULLET + "\n\n" + content, encoding="utf-8")

    doc = relay_doc_path(root)
    verify_entry = detect_verify_entry(root)
    if not doc.exists():
        ref_line = f"- 参考实现/材料：`{reference}`\n" if reference else ""
        spine_line = (
            f"- 架构主线：{spine}\n"
            if spine
            else "- 架构主线：单一权威领域状态机 + 自驱事件管道 + 纯投影视图（零胶水代码拼接）\n"
        )
        template = (
            f"# PStack 动态接力队列（{goal}）\n\n"
            "本文件是 PStack 跨对话动态接力的全景路线图（对应 Lauren Tan `pstack` 的 `figure-it-out`、`sequence-verifiable-units`、`guard-the-context-window` 与动态 `Session pickup`）。\n"
            "只预设总方向与滚动切片骨架；**下一棒提示词绝不静态预写**，而是在每一棒收尾时根据真实代码变更、新发现的根因与上下文水位动态合成并更新下一棒。\n\n"
            f"- 总目标：{goal}\n"
            f"{spine_line}"
            f"{ref_line}"
            f"- 自动验收入口：`{verify_entry}`\n"
            "- 决策账本（`show-me-your-work`）：`.scratch/pstack-relay/decisions.tsv`\n"
            "- 动态交接胶囊：`.scratch/pstack-relay/handoff_capsule.json`\n"
            "- 下一棒提示词快照：`.scratch/pstack-relay/NEXT_PROMPT.md`\n\n"
            "---\n\n"
            "## 滚动切片队列（A → D，随每棒真实进展动态演化）\n\n"
            "### [ ] Slice A: 现状摸底、统一架构主线确立与验证杠杆就位\n"
            "- **Playbook**: `Investigation` + `figure-it-out`\n"
            f"- **Outcome**: 摸清当前代码库与目标「{goal}」的差距，确立零胶水代码的统一系统架构主线，确认或建立自动验收入口，并根据真实发现动态合成 Slice B 的精确目标与验收条件。\n"
            "- **Done Predicate**: `docs/pstack-relay.md` 中的后续滚动切片具备可执行命令级 Done Predicate，且 `scripts/pstack-relay selftest` 通过。\n"
            "- **Evidence**: `PENDING`\n\n"
            "### [ ] Slice B: 核心领域状态机与首条高风险端到端主链路贯通\n"
            "- **Playbook**: `Feature`\n"
            "- **Outcome**: 落地统一领域模型与运行时主干，打通最核心、风险最高的第一条端到端数据流，在真实产物上完成验证，并根据实际落地情况动态合成下一棒。\n"
            f"- **Done Predicate**: `{verify_entry}` 与新增端到端行为测试全部 `PASS`。\n"
            "- **Evidence**: `PENDING`\n\n"
            "### [ ] Slice C: 纯投影界面层与完整用户工作流闭环\n"
            "- **Playbook**: `Feature`\n"
            "- **Outcome**: 基于纯视图投影（Projection）与单向意图（Command）完成全部用户可见工作流，消除跨模块胶水代码。\n"
            f"- **Done Predicate**: `{verify_entry}` 全量回归 `PASS`。\n"
            "- **Evidence**: `PENDING`\n\n"
            "### [ ] Slice D: 对抗审查、代码精简与最终交付收口\n"
            "- **Playbook**: `Shipping`\n"
            "- **Outcome**: 对照总目标执行对抗审查（`interrogate`）、清理冗余代码与胶水层（`deslop` / `no-comments`），完成全量验证并生成晨间审计摘要（`show-me-your-work` + `ketchup`）。\n"
            f"- **Done Predicate**: `{verify_entry}` 与 `scripts/pstack-relay status --require-all-done` 全部 `PASS`。\n"
            "- **Evidence**: `PENDING`\n"
        )
        doc.write_text(template, encoding="utf-8")
        append_decision(
            root,
            phase="init",
            decision=f"Initialized dynamic pstack-relay horizon for goal: {goal}",
            why="Bootstrap dynamic rolling prompt synthesis workflow",
            evidence="docs/pstack-relay.md;scripts/pstack-relay;.agents/hooks.json",
            result="OPEN",
        )

    return cmd_status(root, require_all_done=False, copy=copy)


def cmd_status(root: Path, require_all_done: bool, copy: bool) -> int:
    prompt, state = sync_files(root, copy=copy)
    print(
        f"PStack Relay Progress: {state['completed_count']}/{state['total_count']} slices completed. "
        f"Next: {('Slice ' + state['next_slice'] + ' (' + state['next_title'] + ')') if state['next_slice'] else 'ALL DONE'}"
    )
    print(
        f"Saved next prompt to: {state['next_prompt_path']} (clipboard={'yes' if state['copied_to_clipboard'] else 'no'})"
    )
    print("\n## Next Chat Prompt (Copy & Paste)\n")
    print("```text")
    print(prompt.rstrip())
    print("```")
    if require_all_done and state["next_slice"] is not None:
        return 1
    return 0


def _replace_slice_field(section: str, field_name: str, new_val: str) -> str:
    return re.sub(
        rf"^(- \*\*{re.escape(field_name)}\*\*:\s*)(.+)$",
        lambda m: m.group(1) + new_val,
        section,
        count=1,
        flags=re.MULTILINE,
    )


def cmd_advance(
    root: Path,
    slice_id: str,
    evidence: str,
    why: str,
    learned: str | None,
    next_title: str | None,
    next_goal: str | None,
    next_done: str | None,
    watchouts: str | None,
    partial: bool,
    copy: bool,
) -> int:
    doc = relay_doc_path(root)
    text = doc.read_text(encoding="utf-8")
    slices = parse_slices(text)
    target = next((s for s in slices if s["id"].upper() == slice_id.upper()), None)
    if target is None:
        raise SystemExit(f"unknown slice ID: {slice_id}")

    header_pattern = re.compile(
        rf"^(### \[)[ x~](\] Slice {re.escape(target['id'])}: .+)$",
        re.MULTILINE,
    )
    text, count = header_pattern.subn(r"\1x\2", text, count=1)
    if count != 1:
        raise SystemExit(f"failed to update header for Slice {target['id']}")

    matches = list(SLICE_HEADER_RE.finditer(text))
    for idx, m in enumerate(matches):
        if m.group("id").strip().upper() == target["id"].upper():
            start = m.end()
            end = matches[idx + 1].start() if idx + 1 < len(matches) else len(text)
            section = text[start:end]
            section = _replace_slice_field(section, "Evidence", evidence)

            if partial:
                cont_id = f"{target['id']}_CONT"
                cont_title = next_title or f"{target['title']}（续接）"
                cont_outcome = next_goal or target["outcome"]
                cont_pred = next_done or target["predicate"]
                cont_playbook = target["playbook"] or "`Feature`"
                cont_block = (
                    f"\n### [ ] Slice {cont_id}: {cont_title}\n"
                    f"- **Playbook**: {cont_playbook}\n"
                    f"- **Outcome**: {cont_outcome}\n"
                    f"- **Done Predicate**: {cont_pred}\n"
                    "- **Evidence**: `PENDING`\n"
                )
                section = section.rstrip() + "\n" + cont_block + "\n"

            text = text[:start] + section + text[end:]
            break

    # If not --partial, apply dynamic refinements (--next-title, --next-goal, --next-done) to the next pending slice
    if not partial and (next_title or next_goal or next_done):
        updated_slices = parse_slices(text)
        nxt_pending, _ = current_and_last_slice(updated_slices)
        if nxt_pending is not None:
            nid = nxt_pending["id"]
            if next_title:
                nxt_hdr_pat = re.compile(
                    rf"^(### \[[ ~]\] Slice {re.escape(nid)}: )(.+)$",
                    re.MULTILINE,
                )
                text = nxt_hdr_pat.sub(lambda m: m.group(1) + next_title.strip(), text, count=1)
            matches2 = list(SLICE_HEADER_RE.finditer(text))
            for idx2, m2 in enumerate(matches2):
                if m2.group("id").strip().upper() == nid.upper():
                    s2 = m2.end()
                    e2 = matches2[idx2 + 1].start() if idx2 + 1 < len(matches2) else len(text)
                    sec2 = text[s2:e2]
                    if next_goal:
                        sec2 = _replace_slice_field(sec2, "Outcome", next_goal.strip())
                    if next_done:
                        sec2 = _replace_slice_field(sec2, "Done Predicate", next_done.strip())
                    text = text[:s2] + sec2 + text[e2:]
                    break

    doc.write_text(text, encoding="utf-8")

    capsule = load_capsule(root)
    capsule["updated_at"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    capsule["last_completed_slice"] = target["id"]
    capsule["evidence"] = evidence
    if learned:
        capsule["learned"] = learned.strip()
    elif why and why != "Done predicate verified":
        capsule["learned"] = why.strip()
    if watchouts:
        capsule["watchouts"] = watchouts.strip()
    save_capsule(root, capsule)

    decision_why = learned.strip() if learned else (why or "Done predicate satisfied and verified")
    append_decision(
        root,
        phase=f"slice-{target['id'].lower()}",
        decision=f"{'Partially completed & split' if partial else 'Completed'} Slice {target['id']}: {target['title']}",
        why=decision_why,
        evidence=evidence,
        result="SPLIT_FOR_CONTEXT" if partial else "VERIFIED",
    )
    return cmd_status(root, require_all_done=False, copy=copy)


def cmd_hook(root: Path, event: str) -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}

    if not relay_doc_path(root).exists():
        print("{}")
        return 0

    prompt, state = sync_files(root, copy=False)
    nxt = state.get("next_slice")
    if event == "SessionStart":
        if nxt:
            msg = (
                f"[PStack Relay Hook] Active rolling queue: {state['completed_count']}/{state['total_count']} done. "
                f"Current target is Slice {nxt} ({state['next_title']}). "
                f"Read `docs/pstack-relay.md`, `.scratch/pstack-relay/handoff_capsule.json`, and `.scratch/pstack-relay/decisions.tsv`. "
                f"Before ending your turn, dynamically synthesize the next session prompt via `scripts/pstack-relay advance {nxt} --evidence ... --learned ... --next-goal ... --copy` and output the `## Next Chat Prompt (Copy & Paste)` block."
            )
            print(json.dumps({"injectSteps": [{"systemMessage": {"systemMessage": msg}}]}))
            return 0
        print("{}")
        return 0

    if event == "Stop":
        if isinstance(payload, dict) and payload.get("terminationReason") == "NO_TOOL_CALL":
            sync_files(root, copy=True)
        print("{}")
        return 0

    print("{}")
    return 0


def cmd_selftest(root: Path) -> int:
    prompt, state = sync_files(root, copy=False)
    assert state["total_count"] >= 2, "expected at least 2 slices in panorama queue"
    assert Path(state["next_prompt_path"]).exists(), "NEXT_PROMPT.md must exist"
    assert Path(state["decisions_path"]).exists(), "decisions.tsv must exist"
    assert "/poteto-mode" in prompt, "prompt must start with /poteto-mode"
    print("pstack-relay selftest: PASS")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="PStack cross-chat dynamic relay manager")
    parser.add_argument("--root", help="Repository root path override")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_init = sub.add_parser("init", help="Bootstrap pstack-relay in a repository")
    p_init.add_argument("--goal", required=True, help="Plain-language North-Star product outcome")
    p_init.add_argument("--reference", help="Optional reference repo or doc path")
    p_init.add_argument("--spine", help="Optional unified architecture spine summary")
    p_init.add_argument("--copy", action="store_true", help="Copy generated prompt to clipboard")

    p_status = sub.add_parser("status", help="Show relay progress and print dynamically synthesized next prompt")
    p_status.add_argument("--require-all-done", action="store_true")
    p_status.add_argument("--copy", action="store_true", help="Copy next prompt to macOS clipboard")

    for sub_name in ("advance", "handoff"):
        p_adv = sub.add_parser(sub_name, help="Mark slice completed (or split via --partial) and dynamically synthesize next prompt")
        p_adv.add_argument("slice_id", help="Slice ID, e.g. A, B, P, Q")
        p_adv.add_argument("--evidence", required=True, help="Commit SHA, PR, or receipt path")
        p_adv.add_argument("--why", default="Done predicate verified", help="Short reason for decisions.tsv")
        p_adv.add_argument("--learned", help="Key technical facts, root causes, or API shapes established in this session")
        p_adv.add_argument("--next-title", help="Dynamically refine the next slice's title based on current progress")
        p_adv.add_argument("--next-goal", help="Dynamically synthesize/refine the next slice's Outcome based on current progress")
        p_adv.add_argument("--next-done", help="Dynamically synthesize/refine the next slice's Done Predicate command")
        p_adv.add_argument("--watchouts", help="Architectural invariants or traps the next session must respect")
        p_adv.add_argument("--partial", action="store_true", help="Split remaining work into a continuation slice to protect context window")
        p_adv.add_argument("--copy", action="store_true", help="Copy next prompt to macOS clipboard")

    p_hook = sub.add_parser("hook", help="Antigravity lifecycle hook entrypoint")
    p_hook.add_argument("event", choices=["SessionStart", "Stop", "PreInvocation"])

    sub.add_parser("selftest", help="Verify relay files and prompt generation")

    args = parser.parse_args()
    root = repo_root(args.root)
    if args.cmd == "init":
        return cmd_init(root, goal=args.goal, reference=args.reference, spine=args.spine, copy=args.copy)
    if args.cmd == "status":
        return cmd_status(root, require_all_done=args.require_all_done, copy=args.copy)
    if args.cmd in ("advance", "handoff"):
        return cmd_advance(
            root,
            slice_id=args.slice_id,
            evidence=args.evidence,
            why=args.why,
            learned=args.learned,
            next_title=args.next_title,
            next_goal=args.next_goal,
            next_done=args.next_done,
            watchouts=args.watchouts,
            partial=args.partial,
            copy=args.copy,
        )
    if args.cmd == "hook":
        return cmd_hook(root, args.event)
    if args.cmd == "selftest":
        return cmd_selftest(root)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
