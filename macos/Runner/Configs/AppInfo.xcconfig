// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Koe

// The application's bundle identifier. Keep it: the sandbox data container,
// Keychain access and signing requirement are keyed by it (see #36).
PRODUCT_BUNDLE_IDENTIFIER = com.anker.ankerRecorder

// The copyright displayed in application information. Koe is a private,
// self-use modification of tacshi/Soundcore (no upstream license); all rights
// in the upstream code remain with its author. Do not claim other ownership.
PRODUCT_COPYRIGHT = 基于 tacshi/Soundcore 修改，上游代码权利归原作者 tacshi 所有；仅供私人自用。
